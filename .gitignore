# --- build output ---
/dist
/out-tsc
/.next
/.wrangler
/**/.wrangler
/apps/*/dist
/packages/*/dist
/scripts/dist

# --- wrangler-generated types (`wrangler types` regenerates on every deploy) ---
/apps/worker/worker-configuration.d.ts
/**/worker-configuration.d.ts

# --- TS incremental build cache ---
*.tsbuildinfo
.tsbuildinfo
/.tsbuildinfo
/**/.tsbuildinfo

# --- dependencies ---
node_modules
**/node_modules/
/node_modules
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- editors / OS ---
.vscode/*
.idea/
.DS_Store

# --- secrets (never commit) ---
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
.envrc
/.claude/settings.local.json
/.claude/memory/
/.claude/projects/
*.pem
*.key

# --- disposable agent scratch, see .claude/rules/documentation.md ---
/.tmp/
**/.tmp/
.pnpm-store/
/.tmp/claude-hooks/

# --- coverage ---
/coverage
**/coverage
**/.nyc_output

# --- drizzle-kit generated output (regenerated by `drizzle-kit check`
#     and `drizzle-kit generate`; the hand-written SQL in migrations/
#     is the deployable artifact per data-model.md §Migration authority) ---
/migrations/drizzle/
/migrations/drizzle/**

# --- deploy script outputs (CAP-005) ---
/apps/worker/.wrangler.resolved.jsonc
/.cloudflare-resources.json

# --- test temp files ---
**/.tmp-*
