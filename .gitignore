# --- build output ---
/dist
/out-tsc
/.next
/.wrangler
/**/.wrangler
/apps/*/dist
/packages/*/dist

# --- wrangler-generated types (`wrangler types` regenerates on every deploy) ---
/apps/worker/worker-configuration.d.ts
/**/worker-configuration.d.ts

# --- TS incremental build cache ---
*.tsbuildinfo
.tsbuildinfo
/.tsbuildinfo
/**/.tsbuildinfo

# --- dependencies ---
node_modules
**/node_modules/
/node_modules
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- editors / OS ---
.vscode/*
.idea/
.DS_Store

# --- secrets (never commit) ---
.dev.vars
.env
.env.*
!.env.example

# --- disposable agent scratch, see .claude/rules/documentation.md ---
/.tmp/
/.tmp/claude-hooks/

# --- coverage ---
/coverage
**/coverage
**/.nyc_output