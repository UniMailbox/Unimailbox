{
  "name": "@unimailbox/test-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./resource-usage": {
      "types": "./dist/resource-usage.d.ts",
      "default": "./dist/resource-usage.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./brevo-network": {
      "types": "./dist/brevo-network.d.ts",
      "default": "./dist/brevo-network.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@unimailbox/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261008.1",
    "@msw/cloudflare": "0.1.0",
    "msw": "2.14.1",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@cloudflare/vitest-plugin": "*",
    "vitest": "*"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "@cloudflare/vitest-plugin": {
      "optional": true
    }
  }
}
