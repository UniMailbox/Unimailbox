// apps/worker/wrangler.dev.jsonc — local-dev wrangler config.
//
// Production wrangler.jsonc declares the four credentials as
// `secrets_store_secrets` bindings backed by Cloudflare Secrets Store,
// which wrangler dev does not emulate locally and does NOT read from
// .dev.vars (that file only feeds the legacy `secrets` mechanism).
//
// This file mirrors the production binding topology (D1 / R2 / KV /
// Queue / Assets / cron) but substitutes plain `vars` for the four
// secrets so `pnpm dev:worker` boots without a Secrets Store.
//
// The vitest-pool-workers project keeps using wrangler.test.jsonc,
// which serves the same role for tests.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unimailbox-worker-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,

  "observability": { "enabled": true },

  // ---- D1 ----
  // No database_id — wrangler dev auto-provisions a local D1 under
  // .wrangler/state, which is also where scripts/db-migrate.ts persists.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unimailbox-db",
    },
  ],

  // ---- R2 ----
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "unimailbox-attachments",
    },
  ],

  // ---- KV ----
  // No namespace id — wrangler dev auto-provisions locally.
  "kv_namespaces": [
    { "binding": "SETUP_SESSION" },
    { "binding": "CACHE" },
  ],

  // ---- Queue ----
  "queues": {
    "producers": [{ "binding": "OUTBOUND", "queue": "unimailbox-outbound" }],
    "consumers": [{ "queue": "unimailbox-outbound", "max_retries": 5 }],
  },

  // ---- Assets ----
  // Mirror production's SPA fallback so any direct :8787 hit on a
  // browser path returns the web shell. Browser development goes
  // through Vite on :5173 (vite proxies /api/* here), so this only
  // matters for hitting :8787 directly without Vite. Requires
  // `pnpm build:web` once if you want the asset bundle present.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // ---- Triggers ----
  "triggers": { "crons": ["*/2 * * * *"] },

  // ---- Vars (substitute for production secrets_store_secrets) ----
  // Flip AUTH_PROVIDER to "dual" or "better-auth" when testing the
  // newer sign-in flows; "legacy" mirrors the production default.
  "vars": {
    "ENVIRONMENT": "local",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "BETTER_AUTH_ADDITIONAL_TRUSTED_ORIGINS": "http://localhost:5173",
    "AUTH_PROVIDER": "dual",
    "INSTALLATION_TOKEN": "local-installation-token",
    "CREDENTIAL_ENCRYPTION_KEY": "381213oasniasuni121n1io21",
    "BETTER_AUTH_SECRET": "1029291299naosinasnia",
    "CURSOR_SIGNING_KEY": "1io21io@akask1",
  },
}
