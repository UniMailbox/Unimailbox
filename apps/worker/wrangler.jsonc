// CAP-001 — wrangler config skeleton.
// Auto-provisions every binding the system will eventually use.
// Real handler bodies land with later capabilities (CAP-006+).
//
// NOTE: wrangler.test.jsonc mirrors the binding topology for worker-pool tests
// (replacing secrets_store_secrets with vars). When you add a binding here,
// add it there too — the two files must stay in lockstep.
//
// CAP-039 — Deployment substrate: declared the `assets` binding so a single
// `pnpm build` produces a Worker that serves the Vite-built web bundle and
// a queue consumer that drains the outbound queue CAP-023 produces.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unimailbox-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,

  // CAP-001 §Scope — auto-provisioning is stable on wrangler >= 4.39.0.
  // See phase-0-foundation.md §Key technical decisions.
  // account_id left as a placeholder: the operator fills it in at deploy time.
  // See work/active/CAP-001-monorepo-scaffold/task.md §Open questions #2.

  "observability": {
    "enabled": true,
  },

  // ---- D1 — primary relational store ----
  // CAP-039: `migrations_dir` removed; deploy.ts applies migrations in
  // pending-only mode (`scripts/deploy.ts:runRemoteMigrations`) so wrangler
  // deploy never replays the full migrations directory.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unimailbox-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    },
  ],

  // ---- R2 — attachment bytes ----
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "unimailbox-attachments",
    },
  ],

  // ---- KV — setup session + cache ----
  "kv_namespaces": [
    {
      "binding": "SETUP_SESSION",
      "id": "REPLACE_WITH_KV_SETUP_SESSION_ID",
    },
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_CACHE_ID",
    },
  ],

  // ---- Queue — outbound dispatch ----
  // CAP-039: declared the consumer so the deployed Worker drains the
  // outbound queue that CAP-023/CAP-029 enqueue to. max_retries = 5
  // (D1) — Worker-side error taxonomy already short-circuits permanent
  // failures, so 5 leaves room for transient 5xx/429 without exhausting
  // retries on a brief Brevo outage.
  "queues": {
    "producers": [
      {
        "binding": "OUTBOUND",
        "queue": "unimailbox-outbound",
      },
    ],
    "consumers": [
      {
        "queue": "unimailbox-outbound",
        "max_retries": 5,
      },
    ],
  },

  // ---- Assets — Vite-built web bundle ----
  // CAP-039: SPA fallback. wrangler's `not_found_handling` returns
  // index.html for any non-API GET the asset binding can't resolve
  // (see D2 — Worker-side manual fallback rejected). `directory` is
  // relative to this file (apps/worker/wrangler.jsonc), per wrangler 4.x.
  // CAP-039 D5: `run_worker_first` with the value `/api/star` enforces the
  // API-never-reaches-assets invariant at the Cloudflare platform layer.
  // Without this flag, the `not_found_handling: "single-page-application"`
  // rewrite fires on browser navigations to unknown paths and would
  // return the SPA shell for e.g. an unknown route under the api prefix.
  // With it set, the Worker always handles api-prefixed requests first;
  // the router's `startsWith('/api/v1')` guard is now belt-and-braces.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // ---- Triggers — scheduled handler ----
  // CAP-001 ships the `scheduled` handler in `entrypoints/scheduled.ts`.
  // CAP-028: the outbound-job reclaim runs every 2 minutes (see
  // apps/worker/src/platform/outbox-config.ts for the lease TTL).
  "triggers": {
    "crons": ["*/2 * * * *"],
  },

  // ---- Secrets Store — secrets the Worker reads via env.<name> ----
  "secrets_store_secrets": [
    {
      "binding": "INSTALLATION_TOKEN",
      "store_id": "REPLACE_WITH_SECRETS_STORE_ID",
      "secret_name": "INSTALLATION_TOKEN",
    },
    {
      "binding": "CREDENTIAL_ENCRYPTION_KEY",
      "store_id": "REPLACE_WITH_SECRETS_STORE_ID",
      "secret_name": "CREDENTIAL_ENCRYPTION_KEY",
    },
  ],

  // ---- Vars — non-secret env vars (placeholder values only) ----
  "vars": {
    "ENVIRONMENT": "local",
  },
}
