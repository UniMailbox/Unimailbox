{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "lib": ["ES2022"],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    ".wrangler",
    "vitest.config.ts",
    "vitest.unit.config.ts",
    "vitest.workers.config.ts",
    "tsconfig.node.json",
    "src/**/*.test.ts"
  ]
}