// Test-only wrangler config for the vitest workers project.
// Replaces secrets_store_secrets with plain vars so miniflare can provide
// values without a backing Secrets Store. readSecret() in platform/secrets.ts
// handles both string (test) and SecretsStoreSecret (production) forms.
// The committed wrangler.jsonc remains the production config.
//
// CAP-039 — Deployment substrate: mirrored the assets binding + queues
// consumer from wrangler.jsonc so worker-pool tests exercise the same
// binding topology. `migrations_dir` removed (pending-only deploy).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unimailbox-worker-test",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,

  "observability": { "enabled": false },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unimailbox-db",
      "database_id": "test"
    }
  ],

  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "test-attachments" }
  ],

  "kv_namespaces": [
    { "binding": "SETUP_SESSION", "id": "test-setup-session" },
    { "binding": "CACHE", "id": "test-cache" }
  ],

  "queues": {
    "producers": [
      { "binding": "OUTBOUND", "queue": "test-outbound" }
    ],
    "consumers": [
      { "queue": "test-outbound", "max_retries": 5 }
    ]
  },

  // CAP-039: SPA fallback — same shape as production. The test pool
  // serves assets from the real `apps/web/dist` build so SPA fallback
  // tests run against the actual hashed bundle. CAP-039 D5: mirrors
  // production's `run_worker_first` so worker-pool tests exercise the
  // same routing precedence the deployed Worker has.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "triggers": { "crons": ["*/2 * * * *"] },

  "vars": {
    "ENVIRONMENT": "local",
    "INSTALLATION_TOKEN": "test-installation-token",
    "CREDENTIAL_ENCRYPTION_KEY": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  }
}