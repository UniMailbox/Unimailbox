{
  // R2 overlay — enable Cloudflare R2 as the attachment backend without
  // touching the default `wrangler.jsonc` (which intentionally keeps KV as
  // the free-tier default).
  //
  // Apply with:
  //     pnpm deploy:r2
  //
  // After deployment, the runtime auto-detects the `ATTACHMENTS` binding and
  // switches new writes to R2 and retains KV as a read fallback until you run
  // the migration script:
  //     pnpm migrate:kv-to-r2 --bucket unimailbox-attachments
  //
  // This file is intentionally self-contained — Wrangler reads only the file
  // passed via `-c`, so all bindings are redeclared. Keep it in sync with
  // `wrangler.jsonc` whenever other bindings change.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unimailbox",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/setup*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unimailbox",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "unimailbox-attachments",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "unimailbox-messages",
    },
  ],
  "ai_gateway": [
    {
      "binding": "AI_GATEWAY",
      "name": "unimailbox-mcp",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "OUTBOUND_QUEUE",
        "queue": "unimailbox-outbound",
      },
      {
        "binding": "INBOX_INDEX_QUEUE",
        "queue": "unimailbox-inbox-index",
      },
    ],
    "consumers": [
      {
        "queue": "unimailbox-outbound",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "unimailbox-outbound-dead",
      },
      {
        "queue": "unimailbox-inbox-index",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "unimailbox-inbox-index-dead",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAILBOX_AGENT",
        "class_name": "MailboxAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MailboxAgent"],
    },
  ],
  "triggers": {
    "crons": ["* * * * *", "0 * * * *", "17 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "unimailbox-preview",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "unimailbox-preview-attachments",
        },
      ],
      "ai": {
        "binding": "AI",
      },
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "unimailbox-preview-messages",
        },
      ],
      "ai_gateway": [
        {
          "binding": "AI_GATEWAY",
          "name": "unimailbox-mcp",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OUTBOUND_QUEUE",
            "queue": "unimailbox-preview-outbound",
          },
          {
            "binding": "INBOX_INDEX_QUEUE",
            "queue": "unimailbox-preview-inbox-index",
          },
        ],
        "consumers": [
          {
            "queue": "unimailbox-preview-outbound",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "unimailbox-preview-outbound-dead",
          },
          {
            "queue": "unimailbox-preview-inbox-index",
            "max_batch_size": 25,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "unimailbox-preview-inbox-index-dead",
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "MAILBOX_AGENT",
            "class_name": "MailboxAgent",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["MailboxAgent"],
        },
      ],
    },
  },
}
